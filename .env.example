# ── LLM Provider ──────────────────────────
# Uncomment and set the API key for your provider
# OPENROUTER_API_KEY=sk-or-v1-xxx
# ZHIPU_API_KEY=xxx
# ANTHROPIC_API_KEY=sk-ant-xxx
# OPENAI_API_KEY=sk-xxx
# GEMINI_API_KEY=xxx
# MODELSCOPE_API_KEY=xxx
# CLAUDE_CODE_OAUTH=xxx
# ── Chat Channel ──────────────────────────
# TELEGRAM_BOT_TOKEN=123456:ABC...
# DISCORD_BOT_TOKEN=xxx
# Feishu (飞书)
# PICOCLAW_CHANNELS_FEISHU_APP_ID=cli_xxx
# PICOCLAW_CHANNELS_FEISHU_APP_SECRET=xxx
# PICOCLAW_CHANNELS_FEISHU_RANDOM_REACTION_EMOJI=Typing,OneSecond

# ── Web Search (optional) ────────────────
# BRAVE_SEARCH_API_KEY=BSA...

# ── Timezone ──────────────────────────────
TZ=Asia/Makassar

# ── Kios (kios-picoclaw) ─────────────────
# API key provider kios
# GROQ_API_KEY=gsk_xxx
# GEMINI_API_KEY=xxx
# Kredensial Upstash Redis (rediss:// URL)
# UPSTASH_REDIS_URL=rediss://default:xxx@xxx.upstash.io:6379
# Telegram IDs yang diizinkan memakai bot (comma-separated). Wajib diisi.
# KIOS_ALLOW_FROM=111111111,222222222
# Bootstrap owner IDs (comma-separated Telegram IDs).
# User ini SELALU owner meski KIOS_DEFAULT_ROLE=kasir — mencegah lockout.
# Harus SAMA dengan KIOS_OWNER_IDS di dashboard (Vercel).
# KIOS_OWNER_IDS=111111111,222222222
# Role default user whitelist yang belum terdaftar di kios:users.
# "owner" (default) = akses penuh; "kasir" = batasi aksi destruktif.
# KIOS_DEFAULT_ROLE=owner
# Laporan harian otomatis ke Telegram (aktif bila diisi)
# KIOS_REPORT_CHAT=
# Opsional: override jadwal cron (default: 0 18 * * *, TZ Asia/Makassar)
# KIOS_REPORT_CRON=
# Base URL dashboard untuk /api/summary (tanpa trailing slash)
# KIOS_DASHBOARD_URL=
# Rahasia HMAC service — HARUS sama dengan KIOS_SERVICE_SECRET di dashboard
# KIOS_SERVICE_SECRET=
# Ambang alert pesanan pending menumpuk (default 5)
# KIOS_PENDING_ALERT_THRESHOLD=
# Backup harian otomatis: set chat/ID Telegram tujuan untuk mengaktifkan.
# Kosong = mati. Snapshot JSON dikirim sebagai file ke Telegram.
# KIOS_BACKUP_CHAT=
# Override jadwal cron backup (default: 0 22 * * *, TZ Asia/Makassar)
# KIOS_BACKUP_CRON=
# Direktori file backup di disk (default subdir temp). Salinan durable di Telegram.
# KIOS_BACKUP_DIR=
# Direktori template Excel (.xlsx); default "templates". Jarang perlu diubah.
# KIOS_TEMPLATE_DIR=
# One-time migration: path absolut ke folder CSV/JSON lama (stok.csv, dst).
# Kosong = mulai dari Redis (tidak seed).
# KIOS_SEED_DIR=
# Set ke 1 untuk paksa seed ulang walau seed sebelumnya sudah selesai.
# KIOS_SEED_FORCE=
