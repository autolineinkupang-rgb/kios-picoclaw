# ─────────────────────────────────────────────────────────────────────────
# Kios Cerdas — Dashboard & Admin CMS
# Salin file ini menjadi .env.local (lokal) atau set di Vercel Project Settings.
# ─────────────────────────────────────────────────────────────────────────

# Upstash Redis — REST API (BUKAN rediss:// TCP yang dipakai bot Go).
# Ambil dari Upstash Console -> database kamu -> tab "REST API".
# Database HARUS sama dengan yang dipakai bot Telegram supaya datanya satu sumber.
UPSTASH_REDIS_REST_URL="https://xxxx.upstash.io"
UPSTASH_REDIS_REST_TOKEN="xxxxxxxxxxxxxxxxxxxxxxxx"

# Telegram Login Widget.
# - BOT_TOKEN: token bot yang sama dengan bot kios (dari @BotFather). Dipakai
#   untuk memverifikasi hash login. JANGAN diawali "bot".
# - BOT_USERNAME: username bot tanpa "@" (mis. kioscerdas_bot). Dipakai widget.
# Jangan lupa daftarkan domain dashboard di @BotFather: /setdomain
TELEGRAM_BOT_TOKEN="123456:ABC-DEF..."
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME="kioscerdas_bot"

# Daftar Telegram user ID (dipisah koma) yang otomatis menjadi owner penuh.
# Samakan dengan KIOS_OWNER_IDS di bot. Selain ID ini, akses ditentukan oleh
# record di Redis hash kios:users (harus aktif).
KIOS_OWNER_IDS="111111111,222222222"

# Rahasia untuk menandatangani cookie sesi (JWT). Buat string acak panjang:
#   openssl rand -base64 48
SESSION_SECRET="ganti-dengan-string-acak-minimal-32-karakter"
