# kios-picoclaw environment — set these as Railway service Variables.
# NEVER commit real values. This file documents the variables only.

# --- Required ---
# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token
# Comma-separated Telegram USER IDs allowed to use the bot (the whitelist).
# Get your id from @userinfobot. Example: 111111111,222222222
KIOS_ALLOW_FROM=111111111,222222222
# Groq API key (primary LLM). https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_key
# Upstash Redis connection URL (rediss://...). https://console.upstash.com
UPSTASH_REDIS_URL=rediss://default:password@your-db.upstash.io:6379

# --- Optional ---
# Gemini API key (fallback LLM). If unset, Gemini is not added.
GEMINI_API_KEY=
# Anthropic (Claude) API key (fallback LLM). https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Override default models if needed.
GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
GEMINI_MODEL=gemini-2.0-flash
ANTHROPIC_MODEL=claude-sonnet-4-6
# Role assumed for whitelisted users not registered in kios:users.
# "owner" (default) = full access; "kasir" = restrict destructive actions.
KIOS_DEFAULT_ROLE=owner
# Laporan harian otomatis: set ke chat/ID Telegram tujuan untuk mengaktifkan.
# Kosong = fitur mati. Laporan dibuat tanpa LLM (tahan rate limit).
KIOS_REPORT_CHAT=
# Jadwal cron laporan (default tiap hari 18:00 WITA). Format cron 5-field.
KIOS_REPORT_CRON=0 18 * * *
# Dashboard web (Next.js) base URL, mis. https://kios-anu.vercel.app. Dipakai
# perintah /web, /login, dan tarik ringkasan dashboard. Kosong = fitur mati.
KIOS_DASHBOARD_URL=
# Rahasia bersama untuk autentikasi service bot -> dashboard (header
# X-Kios-Service). HARUS sama persis dengan KIOS_SERVICE_SECRET di dashboard.
# Minimal 16 karakter; buat acak: openssl rand -base64 32
KIOS_SERVICE_SECRET=
# One-time migration: absolute path to a dir with the legacy CSV/JSON
# (stok.csv, transaksi.csv, pembelian.csv, price-history.csv, users.json).
# Leave UNSET on Railway (starts fresh; data lives in Redis).
KIOS_SEED_DIR=

# PORT is injected by Railway automatically — do not set manually.
