# kios-picoclaw environment — set these as Railway service Variables.
# NEVER commit real values. This file documents the variables only.

# --- Required ---
# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token
# Comma-separated Telegram USER IDs allowed to use the bot (the whitelist).
# Get your id from @userinfobot. Example: 111111111,222222222
KIOS_ALLOW_FROM=111111111,222222222
# Groq API key (primary LLM). https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_key
# Upstash Redis connection URL (rediss://...). https://console.upstash.com
UPSTASH_REDIS_URL=rediss://default:password@your-db.upstash.io:6379

# --- Optional ---
# Gemini API key (fallback LLM). If unset, Gemini is not added.
GEMINI_API_KEY=
# Anthropic (Claude) API key (fallback LLM). https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Override default models if needed (mudah diganti — set salah satu ini).
#   Groq:   https://console.groq.com/docs/models
#   Gemini: gemini-2.0-flash | gemini-1.5-flash | gemini-1.5-pro
#   Claude: claude-sonnet-4-6 | claude-haiku-4-5-20251001
GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
GEMINI_MODEL=gemini-2.0-flash
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Model bebas (provider apa pun, TANPA edit file) ---
# Ganti PRIMARY ke provider lain cukup lewat env ini. Kalau KIOS_MODEL diisi,
# ia jadi primary dan GROQ_API_KEY tidak lagi wajib.
#   KIOS_MODEL      = "protocol/model-id", mis:
#                     openai/gpt-4o-mini | deepseek/deepseek-chat |
#                     moonshot/kimi-k2 | mistral/mistral-large-latest |
#                     openrouter/anthropic/claude-3.5-sonnet
#   KIOS_MODEL_KEY  = API key untuk model di atas (wajib, kecuali pakai _BASE lokal tanpa key)
#   KIOS_MODEL_BASE = endpoint OpenAI-compatible custom (opsional)
#   KIOS_MODEL_NAME = alias model_name (opsional, default "primary")
KIOS_MODEL=
KIOS_MODEL_KEY=
KIOS_MODEL_BASE=
KIOS_MODEL_NAME=
# Tambah model EKSTRA berapa pun (array JSON model_list). Dipakai sebagai
# fallback bila model_name-nya didaftarkan di KIOS_EXTRA_FALLBACKS (pisah koma).
#   KIOS_EXTRA_MODELS='[{"model_name":"kimi","model":"moonshot/kimi-k2","api_keys":["sk-..."]}]'
#   KIOS_EXTRA_FALLBACKS=kimi
KIOS_EXTRA_MODELS=
KIOS_EXTRA_FALLBACKS=
# Smart routing per kompleksitas pesan. DEFAULT MATI (kosong/"off") = semua
# pesan ke Groq (primary); Gemini/Claude cuma fallback saat Groq gagal.
# Set "on" HANYA jika ingin pesan ringan dilempar ke Gemini/Claude. Hati-hati:
# Gemini free-tier kuota kecil → bisa 429. Biarkan kosong untuk hindari 429.
KIOS_ROUTING=
# Saat KIOS_ROUTING=on, arahkan tier ringan/menengah ke model_name APA SAJA
# (termasuk dari KIOS_EXTRA_MODELS). Kosong = pakai preset Gemini/Claude.
KIOS_ROUTING_LIGHT=
KIOS_ROUTING_MEDIUM=
# Role assumed for whitelisted users not registered in kios:users.
# "owner" (default) = full access; "kasir" = restrict destructive actions.
KIOS_DEFAULT_ROLE=owner
# Laporan harian otomatis: set ke chat/ID Telegram tujuan untuk mengaktifkan.
# Kosong = fitur mati. Laporan dibuat tanpa LLM (tahan rate limit).
KIOS_REPORT_CHAT=
# Jadwal cron laporan (default tiap hari 18:00 WITA). Format cron 5-field.
KIOS_REPORT_CRON=0 18 * * *
# Backup otomatis: set ke chat/ID Telegram tujuan untuk mengaktifkan.
# Kosong = fitur mati.
KIOS_BACKUP_CHAT=
# Jadwal cron backup (default tiap hari 22:00 WITA). Format cron 5-field.
KIOS_BACKUP_CRON=0 22 * * *
# Dashboard web (Next.js) base URL, mis. https://kios-anu.vercel.app. Dipakai
# perintah /web, /login, dan tarik ringkasan dashboard. Kosong = fitur mati.
KIOS_DASHBOARD_URL=
# Rahasia bersama untuk autentikasi service bot -> dashboard (header
# X-Kios-Service). HARUS sama persis dengan KIOS_SERVICE_SECRET di dashboard.
# Minimal 16 karakter; buat acak: openssl rand -base64 32
KIOS_SERVICE_SECRET=
# One-time migration: absolute path to a dir with the legacy CSV/JSON
# (stok.csv, transaksi.csv, pembelian.csv, price-history.csv, users.json).
# Leave UNSET on Railway (starts fresh; data lives in Redis).
KIOS_SEED_DIR=
# Ekonomi mode: matikan laporan + backup otomatis (notif stok & pesanan tetap jalan).
# Set "true" untuk menghemat request LLM di Groq/Gemini free tier.
KIOS_EKONOMI_MODE=
# Jam aktif WITA. Format "HH-HH" (24 jam WITA). Dipakai oleh IsServiceAktif().
# Contoh: "07-22" = aktif jam 07:00–22:00, "22-06" = aktif malam s.d. subuh.
# Kosong = aktif 24 jam (default). Penggunaan ke laporan/backup akan ditambah bertahap.
KIOS_JAM_AKTIF=

# PORT is injected by Railway automatically — do not set manually.
